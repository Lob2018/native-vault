@startuml
skinparam actorStyle hollow
skinparam packageStyle rectangle
skinparam linetype polyline

left to right direction

actor "Application client" as Client

rectangle "NativeVault system" {
    usecase "Store secret" as UC1
    usecase "Retrieve secret" as UC2
    usecase "Delete secret" as UC3
    usecase "Check secret existence" as UC4
    usecase "Verify credential storage" as UC5
    usecase "Select platform credential storage" as UC6
}

Client -- UC1
Client -- UC2
Client -- UC3
Client -- UC4

UC1 ..> UC5 : <<include>>
UC2 ..> UC5 : <<include>>
UC3 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>

UC5 ..> UC6 : <<include>>
@enduml